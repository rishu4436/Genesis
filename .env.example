# =============================================================================
# Genesis — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Network ---
GENESIS_NETWORK=bsc-mainnet          # bsc-testnet | bsc-mainnet
GENESIS_LOOP_INTERVAL_SECONDS=300    # Agent loop interval (5 min default)

# --- LLM (structured decisions via instructor) ---
# Primary: Grok (xAI) — default for Premium+ users
XAI_API_KEY=
LLM_PROVIDER=grok                    # grok | openai | anthropic
LLM_MODEL=grok-3-fast                # grok-3-fast | gpt-4o-mini | claude-3-5-sonnet-latest

# Fallback providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- CoinMarketCap Agent Hub (MCP) ---
# Connect to https://mcp.coinmarketcap.com/mcp
CMC_MCP_URL=https://mcp.coinmarketcap.com/mcp
CMC_API_KEY=                         # Optional if x402 enabled; sent as X-CMC-MCP-API-KEY to MCP
CMC_X402_ENABLED=false               # Pay-per-call via TWAK (~0.01 USDC/call, no API key)
CMC_X402_MODE=fallback               # fallback (API key first) | only (x402 only)
CMC_X402_MAX_PAYMENT=10000             # Base: 0.01 USDC (6 dp). BSC USDC: 10000000000000000 (18 dp)
CMC_X402_PREFER_NETWORK=base         # Chain for x402 USDC (base recommended; match funded wallet)

# --- Trust Wallet Agent Kit (TWAK) ---
# Install: curl -fsSL https://raw.githubusercontent.com/trustwallet/tw-agent-skills/main/install.sh | bash
TWAK_CLI_PATH=twak                   # Path to TWAK CLI binary
TWAK_WALLET_MODE=autonomous          # autonomous | interactive
TWAK_NETWORK=bsc-mainnet             # Must match GENESIS_NETWORK

# --- BNB AI Agent SDK (ERC-8004 identity) ---
# Keys managed by TWAK keychain in production; these are for direct SDK registration
BNB_AGENT_NETWORK=bsc-mainnet
WALLET_PASSWORD=                     # For bnbagent keystore encryption
PRIVATE_KEY=                         # Only for first-time setup; remove after keystore created

# --- Agent identity metadata ---
GENESIS_AGENT_NAME=Genesis
GENESIS_AGENT_DESCRIPTION=Self-custody autonomous AI trader on BSC
GENESIS_AGENT_ENDPOINT=http://localhost:8080

# --- Database ---
GENESIS_DB_PATH=./data/genesis.db

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Set false when exposing via Cloudflare tunnel (blocks POST /api/agent/* from the internet)
DASHBOARD_CONTROLS_ENABLED=true

# --- Competition ---
HACKATHON_TRACK=1
HACKATHON_TRACKS=1,2
COMPETITION_AGENT_ID=                # Set after registration
GENESIS_WALLET_ADDRESS=              # TWAK BSC wallet (instant dashboard; auto-saved after setup)